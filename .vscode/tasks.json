{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "0 Levantar MongoDB",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d",
        "mongo"
      ],
      "problemMatcher": []
    },
    {
      "label": "1 Crear fuentes auxiliares MongoDB y API",
      "type": "shell",
      "command": "python",
      "args": [
        "etl/bootstrap_sources.py",
        "--input",
        "C:\\Users\\catal\\Downloads\\train (1).csv"
      ],
      "problemMatcher": []
    },
    {
      "label": "2 Ejecutar ETL muestra 50000",
      "type": "shell",
      "command": "python",
      "args": [
        "etl/run_pipeline.py",
        "--input",
        "C:\\Users\\catal\\Downloads\\train (1).csv",
        "--max-rows",
        "50000"
      ],
      "problemMatcher": []
    },
    {
      "label": "3 Levantar API",
      "type": "shell",
      "command": "uvicorn",
      "args": [
        "api.metadata_api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "4 Abrir dashboard",
      "type": "shell",
      "command": "streamlit",
      "args": [
        "run",
        "dashboards/app.py"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "5 Ejecutar pruebas",
      "type": "shell",
      "command": "pytest",
      "args": [
        "-q"
      ],
      "problemMatcher": []
    }
  ]
}
